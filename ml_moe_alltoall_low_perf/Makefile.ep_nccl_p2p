# Makefile for ep_dispatch_bench_nccl_p2p.cu
# Build inside the uenv or container with nvcc and a CUDA-aware MPI wrapper.
#
# Typical usage:
#   make -f Makefile.ep_nccl_p2p
#   NCCL_DIR=/path/to/nccl make -f Makefile.ep_nccl_p2p

NVCC ?= nvcc
MPICXX ?= mpicxx

# Default NCCL install prefix. Override with NCCL_DIR=/your/path.
NCCL_DIR ?= /user-environment/env/my-prgenv/

CUDA_ARCH ?= -gencode arch=compute_90,code=sm_90

INCLUDES = -I$(NCCL_DIR)/include
LDFLAGS = -L$(NCCL_DIR)/lib -lnccl -lcudart

ep_dispatch_bench_nccl_p2p: ep_dispatch_bench_nccl_p2p.cu
	$(NVCC) -O2 -std=c++11 -ccbin $(MPICXX) $(CUDA_ARCH) $(INCLUDES) -o $@ $< $(LDFLAGS)

clean:
	rm -f ep_dispatch_bench_nccl_p2p

.PHONY: clean
